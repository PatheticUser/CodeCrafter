# =============================================================================
# CodeCrafter Configuration — Copy this to .env and customize
# =============================================================================
# The .env file is gitignored. Keep secrets out of version control.

# ── Application ───────────────────────────────────────────────────────────

# Environment: development, staging, or production
# APP_ENV=development

# ── Ollama / LLM ──────────────────────────────────────────────────────────

# Ollama API endpoint
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Default model
# DEFAULT_MODEL=qwen3.5:cloud

# Maximum tokens per LLM response
# MAX_TOKENS=4096

# ── Agent Loop ────────────────────────────────────────────────────────────

# Maximum steps per user turn
# MAX_AGENT_STEPS=25

# Maximum auto-fix attempts per user turn
# MAX_AUTO_FIX=3

# ── Sessions ──────────────────────────────────────────────────────────────

# Maximum messages to keep in session history
# MAX_SESSION_MESSAGES=30

# ── User Interface ────────────────────────────────────────────────────────

# Default user name (used when name prompt is skipped)
# DEFAULT_USER_NAME=Developer
