# =============================================================================
# CodeCrafter Environment Configuration
# Copy this to .env for local development. NEVER commit .env.
# =============================================================================

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Any OpenAI-compatible Chat Completions API (OpenAI, Gemini, Groq, DeepSeek, etc.)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2

# ── Agent Limits ──────────────────────────────────────────────────────────────
MAX_AGENT_STEPS=25
MAX_AUTO_FIX=3
MAX_TOKENS=8192

# ── Workspace Configuration ───────────────────────────────────────────────────
# Workspace execution backend: 'local' (host directory) or 'docker' (containerized)
WORKSPACE_BACKEND=local
WORKSPACE_ROOT=./workspace
WORKSPACE_COMMAND_TIMEOUT=60
WORKSPACE_CONTAINER_IMAGE=python:3.11-slim

# ── Persistence ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/codecrafter.db

# ── Server Configuration ──────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ── API Security ──────────────────────────────────────────────────────────────
# Optional bearer token for API endpoints. Leave empty to disable.
# API_TOKEN=your-secret-token
