# ============================================================================
# CodeCrafter — Caddy reverse proxy
#
# {$CADDY_SITE} is read from .env.production (injected via env_file):
#   CADDY_SITE=yourdomain.example   → automatic Let's Encrypt TLS (80 + 443)
#   CADDY_SITE=http://203.0.113.10   → bare-IP deployment, HTTP only
#
# Caddy auto-obtains, renews and rotates certificates; no certbot needed.
# Certs persist in the `codecrafter-caddy-data` named volume.
# =============================================================================

{$CADDY_SITE:localhost} {
    # ── Compression ────────────────────────────────────────────────────────
    encode zstd gzip

    # ── Security headers (responses) ───────────────────────────────────────
    header {
        # Prevent MIME-sniffing
        X-Content-Type-Options "nosniff"
        # Prevent clickjacking
        X-Frame-Options "DENY"
        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server banner
        -Server
        # Content Security Policy - restrictive for coding environment
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https; connect-src 'self'; frame-src 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'"
        # Permissions Policy
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb()"
    }

    # ── Reverse proxy → app:8000 on the backend bridge network ─────────────
    reverse_proxy app:8000 {
        # WebSocket upgrade — pass the client's hop-by-hop headers through
        header_up Upgrade {>Upgrade}
        header_up Connection {>Connection}

        # Real client IP for the upstream app
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_addr}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}

        # Stream responses immediately — required for SSE and WebSocket frames
        flush_interval -1

        # Long agent turns: allow up to 300s upstream
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }

    # ── Rate limiting for authentication and agent operations ───────────────
    # Limit repeated auth attempts and expensive agent operations
    limit_conn 100
    limit_req 50  # 50 requests per minute per IP

    # ── Access control ─────────────────────────────────────────────────────
    # Block private IP ranges from accessing the reverse proxy
    # (they should connect directly to the backend if needed)
    # This is handled at the app level, but we add defense in depth

    # ── HSTS ───────────────────────────────────────────────────────────────
    # Only add HSTS for HTTPS connections
    # (Caddy adds this automatically on HTTPS, but explicit is clearer)
    tls {
        # Force HTTPS
        terminate {
            # HSTS will be set by Caddy automatically on HTTPS
        }
    }
}

# Optional: redirect www → apex (uncomment and adjust)
# www.yourdomain.example {
#   redir https://yourdomain.example{uri} permanent
# }